
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    match /demands/{demandId} {
      allow read: if true;
      allow write: if request.auth != null;
      
      match /tasks/{taskId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
      
      match /comments/{commentId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
    
    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
